  "screens": [
    {
      "name": "LandingPageScreen",
      "route": "/home",
      "auth": "public",
      "endpoints": ["GET /api/jobs", "GET /api/featured-jobs"]
    },
    {
      "name": "JobListingCandidateScreen",
      "route": "/jobs",
      "auth": "public-or-authenticated",
      "endpoints": ["GET /api/jobs", "GET /api/departments", "GET /api/skills"]
    },
    {
      "name": "JobDetailScreen",
      "route": "/jobs/:jobId",
      "auth": "public-or-authenticated",
      "endpoints": [
        "GET /api/jobs/{jobId}",
        "GET /api/jobs/{jobId}/applications",
        "GET /api/jobs/{jobId}/funnel"
      ],
      "roleBasedActions": {
        "anonymous": ["VIEW_ONLY"],
        "candidate": ["VIEW_ONLY", "APPLY_JOB"],
        "hr": ["VIEW_APPLICANTS", "EDIT_JOB", "CLOSE_POSTING", "APPROVE_JOB"],
        "manager": ["VIEW_APPLICANTS", "APPROVE_JOB", "REVIEW_APPLICATION"],
        "systemAdmin": ["VIEW_APPLICANTS", "EDIT_JOB", "CLOSE_POSTING", "APPROVE_JOB"]
      }
    },
    {
      "name": "CandidateLoginScreen",
      "route": "/login",
      "auth": "public",
      "endpoints": ["POST /api/auth/login"]
    },
    {
      "name": "InternalLoginScreen",
      "route": "/internal/login",
      "auth": "public",
      "endpoints": ["POST /api/auth/login"]
    },
    {
      "name": "CandidateRegisterScreen",
      "route": "/register",
      "auth": "public",
      "endpoints": ["POST /api/auth/register"]
    },
    {
      "name": "DashboardCandidateScreen",
      "route": "/candidate/dashboard",
      "auth": "candidate",
      "endpoints": [
        "GET /api/candidate/dashboard",
        "GET /api/candidate/applications",
        "GET /api/interviews/upcoming"
      ]
    },
    {
      "name": "MyApplicationScreen",
      "route": "/candidate/my-applications",
      "auth": "candidate",
      "endpoints": [
        "GET /api/candidate/applications",
        "PATCH /api/candidate/applications/{applicationId}/withdraw"
      ]
    },
    {
      "name": "CandidateProfileAndCVManagementScreen",
      "route": "/candidate/profile/*",
      "auth": "candidate",
      "endpoints": [
        "GET /api/candidate/profile",
        "PUT /api/candidate/profile",
        "POST /api/candidate/profile/resume"
      ]
    },
    {
      "name": "HrDashboardScreen",
      "route": "/hr/dashboard",
      "auth": "hr-or-manager-or-admin",
      "endpoints": [
        "GET /api/hr/dashboard",
        "GET /api/hr/applications/recent",
        "GET /api/hr/jobs/pending-approval"
      ]
    },
    {
      "name": "JobManagementScreen",
      "route": "/jobs (internal shell)",
      "auth": "hr-or-manager-or-admin",
      "endpoints": [
        "GET /api/hr/jobs",
        "POST /api/hr/jobs",
        "PATCH /api/hr/jobs/{jobId}",
        "DELETE /api/hr/jobs/{jobId}"
      ]
    },
    {
      "name": "JobCreatingScreen",
      "route": "/hr/jobs/create",
      "auth": "hr-or-admin",
      "endpoints": ["POST /api/hr/jobs", "GET /api/departments", "GET /api/skills"]
    },
    {
      "name": "CandidateListScreen",
      "route": "/hr/candidates",
      "auth": "hr-or-manager-or-admin",
      "endpoints": [
        "GET /api/hr/candidates",
        "GET /api/hr/candidates/{candidateId}",
        "PATCH /api/hr/candidates/{candidateId}"
      ]
    },
    {
      "name": "CandidateApplicationScreen",
      "route": "/hr/applications",
      "auth": "hr-or-manager-or-admin",
      "endpoints": [
        "GET /api/hr/applications",
        "GET /api/hr/applications/{applicationId}",
        "PATCH /api/hr/applications/{applicationId}/status",
        "POST /api/hr/applications/{applicationId}/interviews"
      ]
    },
    {
      "name": "JobInterviewListScreen",
      "route": "/hr/interviews",
      "auth": "hr-or-manager-or-admin",
      "endpoints": [
        "GET /api/hr/interviews",
        "PATCH /api/hr/interviews/{interviewId}"
      ]
    },
    {
      "name": "InterviewScheduleScreen",
      "route": "/hr/interviews/schedule",
      "auth": "hr-or-manager-or-admin",
      "endpoints": [
        "POST /api/hr/interviews",
        "GET /api/hr/applications/{applicationId}"
      ]
    }
  ],
